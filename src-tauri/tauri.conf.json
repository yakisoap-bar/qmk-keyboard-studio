{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QMK Keyboard Studio",
  "version": "0.1.0",
  "identifier": "com.weikav.max102studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QMK Keyboard Studio",
        "width": 1360,
        "height": 880,
        "minWidth": 1102,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "files": {
          "/lib/udev/rules.d/99-weikav-max102.rules": "../udev/99-weikav-max102.rules"
        }
      }
    }
  }
}
